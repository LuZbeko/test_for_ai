# Docker-specific environment variables
NODE_ENV=production
PORT=3000

# Database (production - persistent volume)
DATABASE_URL="file:/app/data/prod.db"

# API Settings
API_VERSION=v1
API_PREFIX=/api

# Security
JWT_SECRET=docker-production-secret-change-in-production
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Health Check
HEALTH_CHECK_TIMEOUT=5000