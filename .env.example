# Environment variables
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="file:./dev.db"

# API Settings
API_VERSION=v1
API_PREFIX=/api

# Security
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug